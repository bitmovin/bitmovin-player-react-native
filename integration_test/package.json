{
  "name": "bitmovin-player-react-native-integration-test",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "bootstrap": "yarn install && yarn prebuild && yarn pods",
    "open:android": "open -a \"Android Studio\" android",
    "open:ios": "xed ios",
    "start": "expo start",
    "android": "expo run:android",
    "preios": "yarn patch-ios-build",
    "test": "node scripts/run-selected-tests.js all",
    "list-tags": "node scripts/run-selected-tests.js list-tags",
    "check:runner": "yarn lint:runner && yarn test:runner",
    "lint:runner": "eslint scripts --ext .js --quiet",
    "test:runner": "node --test scripts/*.test.js",
    "stop-packager": "./scripts/stop-packager.sh",
    "stop-test:android": "./scripts/stop-test-android.sh",
    "prestart-test:ios": "yarn patch-ios-build",
    "stop-test:ios": "./scripts/stop-test-ios.sh",
    "start-test:android": "./scripts/start-test-android.sh",
    "start-test:ios": "./scripts/start-test-ios.sh",
    "test:android": "node scripts/run-selected-tests.js android",
    "test:ios": "node scripts/run-selected-tests.js ios",
    "patch-ios-build": "./scripts/patch-ios-build.sh",
    "pods": "yarn pods-install || yarn pods-update",
    "pods-install": "./scripts/pods-install.sh",
    "pods-update": "./scripts/pods-update.sh",
    "prebuild": "expo prebuild",
    "prebuild:ios": "yarn patch-ios-build",
    "build:ios": "./scripts/build-ios.sh",
    "build:android": "./scripts/build-android.sh",
    "build:ts": "tsc --noEmit",
    "lint": "eslint src playertesting tests --ext .ts,.tsx,.js,.jsx --quiet",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-tvos/config-tv": "^0.1.1",
    "cavy": "^4.0.2",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-uuid": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@expo/cli": "^57.0.27",
    "@expo/config-types": "^57.0.2",
    "@react-native-community/cli": "latest",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.0",
    "cavy-cli": "github:bitmovin-engineering/cavy-cli#a288754",
    "dotenv": "^17.2.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.1",
    "patch-package": "^8.0.1",
    "pod-install": "^0.3.10",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "react-native": "npm:react-native-tvos@0.86.3-0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "bitmovin-player-react-native",
          "@react-native-tvos/config-tv"
        ]
      }
    },
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
